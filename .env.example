# Local Docker Compose defaults only. Replace every placeholder before deployment.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL (the app database is not published to the host)
DB_NAME=guniapa
DB_USER=guniapa_user
DB_PASSWORD=replace-with-a-unique-local-database-password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Frontend server-side session and API origin
SESSION_SECRET=replace-with-a-different-random-secret-at-least-32-characters
GUNIAPA_API_BASE_URL=http://backend:8000
FRONTEND_URL=http://localhost:8080

# Local HTTP is for development only; production must use HTTPS at a trusted ingress.
SECURE_SSL_REDIRECT=false
TRUST_X_FORWARDED_PROTO=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
CORS_ALLOWED_ORIGINS=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080

# Set NGINX_BIND_ADDRESS to 0.0.0.0 only behind a firewall / trusted TLS ingress.
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_PORT=8080

# API limits and logging
API_PAGE_SIZE=20
API_ANON_RATE=60/hour
API_USER_RATE=300/hour
AUTH_LOGIN_RATE=10/hour
AUTH_REGISTER_RATE=5/hour
AUTH_OTP_RATE=5/hour
LOG_LEVEL=INFO

# No live SMS adapter is included. Production OTP delivery is unavailable until one is implemented.
